<meta name="citation_reference" content="A.V. Mishina, Nauch.-tehn. Journ. Str. I rekonctr.,, 6(38), 70-74, (2011)." />
<meta name="citation_reference" content="D.A. Smirnov, Vestn. Grazhdan. Inzhen., 3(28), 56-60, (2010)." />
